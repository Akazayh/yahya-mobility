.menuside2 img {
vertical-align: top;
padding: 0 8px;
filter: brightness(0) saturate(100%) invert(42%) sepia(22%) saturate(385%) hue-rotate(170deg) brightness(92%) contrast(84%);
}

.menuside2 a {
    padding: 6px 0;
    text-decoration: none;
